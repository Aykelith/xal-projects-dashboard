FROM mcr.microsoft.com/playwright:v1.61.0-noble
WORKDIR /app
RUN npm install -g pnpm@10.11.0
COPY package.json pnpm-lock.yaml ./
RUN pnpm install
COPY . .
# Pre-encrypt all test fixtures at build time so the webServer's pnpm build
# has content to work with (webServer starts before globalSetup in Playwright).
# Also removes the committed production project enc.json so only test projects
# appear (avoids an unexpected 31st project on the home page).
RUN cp -r test-env/fixtures/data/. data/ && \
    rm -f data-encrypted/projects/xal-ai-projects.enc.json && \
    node -e " \
      const {writeFileSync,mkdirSync}=require('fs'); \
      const B=Buffer.from([0xFF,0xD8,0xFF,0xE0,0x00,0x10,0x4A,0x46,0x49,0x46,0x00,0x01,0x01,0x00,0x00,0x01,0x00,0x01,0x00,0x00,0xFF,0xDB,0x00,0x43,0x00,0x08,0x06,0x06,0x07,0x06,0x05,0x08,0x07,0x07,0x07,0x09,0x09,0x08,0x0A,0x0C,0x14,0x0D,0x0C,0x0B,0x0B,0x0C,0x19,0x12,0x13,0x0F,0x14,0x1D,0x1A,0x1F,0x1E,0x1D,0x1A,0x1C,0x1C,0x20,0x24,0x2E,0x27,0x20,0x22,0x2C,0x23,0x1C,0x1C,0x28,0x37,0x29,0x2C,0x30,0x31,0x34,0x34,0x34,0x1F,0x27,0x39,0x3D,0x38,0x32,0x3C,0x2E,0x33,0x34,0x32,0xFF,0xC0,0x00,0x0B,0x08,0x00,0x01,0x00,0x01,0x01,0x01,0x11,0x00,0xFF,0xC4,0x00,0x1F,0x00,0x00,0x01,0x05,0x01,0x01,0x01,0x01,0x01,0x01,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x01,0x02,0x03,0x04,0x05,0x06,0x07,0x08,0x09,0x0A,0x0B,0xFF,0xC4,0x00,0x14,0x10,0x01,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xFF,0xDA,0x00,0x08,0x01,0x01,0x00,0x00,0x3F,0x00,0x7F,0xA4,0x00,0xFF,0xD9]); \
      const ids=['xal-test-project',...Array.from({length:29},(_,i)=>'test-proj-'+String(i+1).padStart(2,'0'))]; \
      mkdirSync('public/photos/home_page',{recursive:true}); \
      mkdirSync('public/photos/covers',{recursive:true}); \
      for(const id of ids){writeFileSync('public/photos/home_page/'+id+'.jpg',B);writeFileSync('public/photos/covers/'+id+'.jpg',B);} \
    " && \
    ENCRYPT_PASSWORD=testpass123 \
    ENCRYPT_SALT=e2e0e2e0e2e0e2e0e2e0e2e0e2e0e2e0 \
    node scripts/encrypt.mjs
CMD ["pnpm", "exec", "playwright", "test", "--config", "test-env/playwright.config.ts"]
