{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "planned",
        "started",
        "done"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "last_activity_at": {
      "type": "string"
    },
    "enc_body": {
      "type": "object",
      "properties": {
        "iv": {
          "type": "string"
        },
        "data": {
          "type": "string"
        }
      },
      "required": [
        "iv",
        "data"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "stage",
    "started_at",
    "last_activity_at"
  ]
}