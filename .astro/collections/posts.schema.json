{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "published_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "enc_body": {
      "type": "object",
      "properties": {
        "iv": {
          "type": "string"
        },
        "data": {
          "type": "string"
        }
      },
      "required": [
        "iv",
        "data"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "project_id",
    "published_at"
  ]
}